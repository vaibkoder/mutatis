{
  "name": "mutatis",
  "version": "0.1.0",
  "description": "Mutatis — client-side Word add-in for Singapore & England-and-Wales legal drafting",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:web": "DP_TARGET=served vite build --config vite.standalone.config.ts",
    "build:single": "DP_TARGET=single vite build --config vite.standalone.config.ts",
    "preview": "vite preview",
    "lint": "eslint src tests eslint-plugins",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check:pdf-offline": "node scripts/check-pdf-offline.mjs",
    "check:render-offline": "node scripts/check-render-offline.mjs",
    "check:offline": "node scripts/check-pdf-offline.mjs && node scripts/check-render-offline.mjs"
  },
  "dependencies": {
    "@fluentui/web-components": "^2.6.1",
    "@microsoft/office-js": "^1.1.0",
    "@preact/signals": "^2.0.0",
    "@types/diff-match-patch": "^1.0.36",
    "chrono-node": "^2.9.1",
    "diff-match-patch": "^1.0.5",
    "fast-diff": "^1.3.0",
    "fast-xml-parser": "^5.8.0",
    "fuse.js": "^7.4.2",
    "pdfjs-dist": "^5.7.284",
    "pizzip": "^3.2.0",
    "preact": "^10.0.0",
    "words-to-numbers": "^1.5.1"
  },
  "devDependencies": {
    "@pdfme/pdf-lib": "^6.1.5",
    "@preact/preset-vite": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/office-js": "^1.0.0",
    "@types/words-to-numbers": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^9.0.0",
    "fontkit": "^2.0.4",
    "globals": "^15.0.0",
    "harfbuzzjs": "^1.2.1",
    "jsdom": "^25.0.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.0.0"
  }
}
