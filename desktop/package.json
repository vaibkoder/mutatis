{
  "name": "mutatis-desktop",
  "version": "0.0.1",
  "description": "Legal document comparison with an AI chat panel. Electron desktop app.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "npm run typecheck && vite build -c vite.web.config.ts && node scripts/check-web-build.mjs",
    "check:web": "node scripts/ui-check-web.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src eslint-plugins",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "dist": "npm run build && electron-builder --dir --config electron-builder.config.cjs",
    "audit:egress": "node scripts/egress-audit.mjs",
    "check:chat": "node scripts/ui-check-chat.mjs",
    "check:ai": "node scripts/ui-check-ai.mjs",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.config.cjs",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.config.cjs",
    "check:signing": "node scripts/check-signing.mjs",
    "smoke": "electron scripts/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "2.0.44",
    "@ai-sdk/deepseek": "3.0.42",
    "@ai-sdk/react": "4.0.100",
    "@base-ui/react": "1.8.0",
    "@pdfme/pdf-lib": "6.1.5",
    "@preact/signals": "2.9.1",
    "ai": "7.0.97",
    "chrono-node": "2.9.1",
    "cn": "0.2.6",
    "diff-match-patch": "1.0.5",
    "electron-updater": "6.8.9",
    "fast-diff": "1.3.0",
    "fast-xml-parser": "5.8.0",
    "fontkit": "2.0.4",
    "fuse.js": "7.4.2",
    "harfbuzzjs": "1.2.1",
    "lucide-react": "1.44.0",
    "pdfjs-dist": "5.7.284",
    "pizzip": "3.2.0",
    "preact": "10.29.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.4",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "words-to-numbers": "1.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/diff-match-patch": "1.0.36",
    "@types/node": "22.18.1",
    "@types/office-js": "1.0.377",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.10.0",
    "happy-dom": "21.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.0"
  }
}
